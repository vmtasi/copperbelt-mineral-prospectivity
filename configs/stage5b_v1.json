{
  "schema_version": "1.0.0",
  "project_crs": "EPSG:32735",
  "purpose": "Stage 5B Voronoi-versus-literal-hexagon support sensitivity with area, positional and outcome-propagation diagnostics",
  "stage5": {
    "config": "configs/stage5_v1.json",
    "inventory_manifest": "data/processed/stage5/stage5_inventory_manifest_v1.json",
    "inventory_validation": "data/processed/stage5/stage5_inventory_validation_v1.json"
  },
  "support_scenarios": [
    {
      "id": "VORONOI_ALL",
      "label": "All 2,193 tract-clipped Voronoi catchments",
      "family": "voronoi",
      "hex_threshold": null,
      "record_filter_threshold": null,
      "role": "reference"
    },
    {
      "id": "VORONOI_MATCHED_HEX_ALL",
      "label": "All Voronoi catchments, records inside any nominal hex",
      "family": "voronoi",
      "hex_threshold": null,
      "record_filter_threshold": 0.0,
      "role": "support_control"
    },
    {
      "id": "VORONOI_MATCHED_HEX80",
      "label": "All Voronoi catchments, records inside >=80% hexagons",
      "family": "voronoi",
      "hex_threshold": null,
      "record_filter_threshold": 0.8,
      "role": "support_control"
    },
    {
      "id": "VORONOI_MATCHED_HEX99",
      "label": "All Voronoi catchments, records inside >=99% hexagons",
      "family": "voronoi",
      "hex_threshold": null,
      "record_filter_threshold": 0.99,
      "role": "support_control"
    },
    {
      "id": "HEX_ALL",
      "label": "All 2,193 nominal 10 km2 hexagons (gapped frame)",
      "family": "hex",
      "hex_threshold": 0.0,
      "record_filter_threshold": 0.0,
      "role": "literal_support"
    },
    {
      "id": "HEX_GE80",
      "label": "Literal hexagons with >=80% tract overlap",
      "family": "hex",
      "hex_threshold": 0.8,
      "record_filter_threshold": 0.8,
      "role": "literal_support"
    },
    {
      "id": "HEX_GE99",
      "label": "Literal hexagons with >=99% tract overlap",
      "family": "hex",
      "hex_threshold": 0.99,
      "record_filter_threshold": 0.99,
      "role": "literal_support"
    }
  ],
  "models": {
    "reference_id": "S0_NO_GRAVITY",
    "outcome": "n_records",
    "offset": "log_support_area_km2",
    "ridge_lambda": 1.0,
    "area_elasticity_ridge_lambda": 0.0,
    "confidence_level": 0.95,
    "block_bootstrap": {
      "block_size_km": 50.0,
      "n_resamples": 1000,
      "seed": 20261107
    },
    "outcome_sensitivities": [
      {"id": "GROUP_EXPANDED", "label": "Group-expanded record count", "outcome": "n_expanded_records"},
      {"id": "DEPOSIT_ONLY", "label": "Deposits only", "outcome": "n_deposits"},
      {"id": "DEPOSIT_PLUS_PROSPECT", "label": "Deposits plus prospects", "outcome": "n_deposits_plus_prospects"}
    ]
  },
  "outputs": {
    "processed_dir": "data/processed/stage5b",
    "figure_dir": "outputs/stage5b",
    "support_comparison": "stage5b_support_comparison_v1.csv",
    "support_gpkg": "stage5b_support_scenarios_v1.gpkg",
    "record_assignments": "stage5b_record_assignments_v1.csv",
    "record_accounting": "stage5b_record_accounting_v1.csv",
    "fold_composition": "stage5b_fold_composition_v1.csv",
    "positional_propagation": "stage5b_positional_propagation_v1.csv",
    "positional_summary": "stage5b_positional_summary_v1.csv",
    "model_predictions": "stage5b_model_predictions_v1.csv",
    "model_metrics": "stage5b_model_metrics_v1.csv",
    "fold_metrics": "stage5b_fold_metrics_v1.csv",
    "coefficients": "stage5b_coefficients_v1.csv",
    "coefficient_summary": "stage5b_coefficient_summary_v1.csv",
    "metric_bootstrap": "stage5b_metric_bootstrap_v1.csv",
    "area_diagnostics": "stage5b_area_diagnostics_v1.csv",
    "boundary_diagnostics": "stage5b_boundary_diagnostics_v1.csv",
    "lost_record_diagnostics": "stage5b_lost_record_diagnostics_v1.csv",
    "outcome_sensitivity": "stage5b_outcome_sensitivity_v1.csv",
    "scenario_figure": "stage5b_support_scenarios.png",
    "retention_figure": "stage5b_record_retention.png",
    "metric_figure": "stage5b_support_metrics.png",
    "diagnostic_figure": "stage5b_area_boundary_diagnostics.png",
    "report": "stage5b_support_sensitivity_report_v1.md",
    "manifest": "stage5b_manifest_v1.json"
  }
}
