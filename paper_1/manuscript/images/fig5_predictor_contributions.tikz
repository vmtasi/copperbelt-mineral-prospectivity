\begin{tikzpicture}[x=1mm,y=1mm,font=\scriptsize]
\definecolor{faultshare}{HTML}{3B6E8F}
\definecolor{contactshare}{HTML}{D98C3F}
\definecolor{gravityshare}{HTML}{579B75}
\definecolor{rockshare}{HTML}{8B78A8}
\def\barscale{1.10}
\def\barheight{5.0}

% Axes and grid
\foreach \x in {0,25,50,75,100}{
  \draw[black!18] ({\x*\barscale},4) -- ({\x*\barscale},36);
  \node[text=black!70, anchor=south] at ({\x*\barscale},36.5) {\x};
}
\draw[black!45] (0,4) -- ({100*\barscale},4);
\node[rotate=90, anchor=south] at (-14,20) {Along-belt fold};
\node[anchor=south] at ({50*\barscale},41) {SD-normalized component share (\%)};

% One bar per fold, with the fold label aligned to its own bar
\foreach \i/\fold/\fault/\contact/\gravity/\rock in {
  1/1/86.5/10.9/2.1/0.4,
  2/2/45.1/29.9/5.8/19.2,
  3/3/30.4/32.9/14.3/22.4,
  4/4/33.5/22.8/28.8/15.0
}{
  \pgfmathsetmacro{\y}{32-8*\i}
  \pgfmathsetmacro{\total}{\fault+\contact+\gravity+\rock}
  \pgfmathsetmacro{\wFault}{\fault*100/\total}
  \pgfmathsetmacro{\wContact}{\contact*100/\total}
  \pgfmathsetmacro{\wGravity}{\gravity*100/\total}
  \pgfmathsetmacro{\xFault}{\wFault*\barscale}
  \pgfmathsetmacro{\xContact}{\xFault+\wContact*\barscale}
  \pgfmathsetmacro{\xGravity}{\xContact+\wGravity*\barscale}
  \pgfmathsetmacro{\xEnd}{100*\barscale}
  \node[anchor=east] at (-2,\y+0.5*\barheight) {Fold \fold};
  \fill[faultshare] (0,\y) rectangle (\xFault,\y+\barheight);
  \fill[contactshare] (\xFault,\y) rectangle (\xContact,\y+\barheight);
  \fill[gravityshare] (\xContact,\y) rectangle (\xGravity,\y+\barheight);
  \fill[rockshare] (\xGravity,\y) rectangle (\xEnd,\y+\barheight);
  \draw[white, line width=0.25pt] (0,\y) rectangle (\xEnd,\y+\barheight);
}

% Two-row legend below the plotting area
\fill[faultshare] (0,-4) rectangle ++(3,3);
\node[anchor=west] at (4.5,-2.5) {Fault distance};
\fill[contactshare] (45,-4) rectangle ++(3,3);
\node[anchor=west] at (49.5,-2.5) {Lithology-contact distance};
\fill[gravityshare] (0,-11) rectangle ++(3,3);
\node[anchor=west] at (4.5,-9.5) {Bouguer gravity};
\fill[rockshare] (45,-11) rectangle ++(3,3);
\node[anchor=west] at (49.5,-9.5) {Surficial-lithology class};
\end{tikzpicture}
